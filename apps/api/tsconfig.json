{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@repo/contracts/*": ["../../packages/contracts/src/*"],
      "@repo/queue/*": ["../../packages/queue/src/*"]
    }
  },
  "references": [{ "path": "../../packages/contracts" }, { "path": "../../packages/queue" }],
  "include": ["src/**/*"]
}
