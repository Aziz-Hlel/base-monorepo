// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}


enum Gender {
  MALE
  FEMALE
}

enum AccountRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DISABLED 
  DELETED
}

enum UserRole {
  OWNER
  DIRECTOR
  MANAGER
  NURSE
  DRIVER
  TEACHER
  PARENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  DISABLED 
  DELETED
}


model Account {
  id    String     @id @default(uuid())
  authId String @unique
  email String?  @unique
  provider String
  username String?
  role AccountRole @default(USER)
  isEmailVerified Boolean @default(false)
  status UserStatus @default(ACTIVE)

  users USER[]

  notificationTargets NotificationTargetUser[]

  createdNotifications   Notification[] @relation("NotificationCreatedBy")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model fees {
  id String @id @default(uuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId,studentId])
}






model School {
  id String @id @default(uuid())
  name String @db.VarChar(255)
  address String @db.Text
  phone String @db.VarChar(255)
  email String @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  users USER[]
  students Student[]

  logoId String? @unique
  logo Media? @relation(fields: [logoId], references: [id], onDelete: SetNull)
}




model USER {
  id String @id @default(uuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  role UserRole @default(PARENT)
  status UserStatus @default(ACTIVE)
  
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  avatarId String? @unique
  avatar Media? @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  parentStudents ParentStudent[]
  
  @@unique([accountId, schoolId, role])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}





model ParentStudent {
  id String @id @default(uuid())

  parentId String
  parent USER @relation(fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Student {
  id String @id @default(uuid())
  name String @db.VarChar(255)
  dateOfBirth DateTime @db.Date
  gender Gender

  parentStudents ParentStudent[]

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  avatarId String? @unique
  avatar Media? @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}