



enum SubjectCategory {
  ARABIC_LANGUAGE
  SCIENCE_TECHNOLOGY
  SOCIAL_EDUCATION
  ART_EDUCATION
  PHYSICAL_EDUCATION
  FRENCH_LANGUAGE
  ENGLISH_LANGUAGE
}

enum Semester {
  FIRST
  SECOND
  THIRD
}

model Exam{
  id String @id @default(uuid()) @db.Uuid

  name_en String @db.VarChar(255)
  name_fr String @db.VarChar(255)
  name_ar String @db.VarChar(255)
  category SubjectCategory

  grade ClassGrade

  schoolId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  examTimes ExamTime[]

  @@unique([schoolId, name_en, grade])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exams")
}

model ExamTime {
  id String @id @default(uuid()) @db.Uuid

  examId String @db.Uuid
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  classId String @db.Uuid
  class Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)

  semester Semester
  day DateTime @db.Date
  startTime DateTime @db.Time
  endTime DateTime @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("examTimes")
}




model ClassSessions{
  id String @id @default(uuid()) @db.Uuid

  classId String @db.Uuid
  class Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)


  title String @db.VarChar(255)
  description String? @db.Text
  day DayOfWeek
  startTime DateTime @db.Time
  endTime DateTime @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String @db.Uuid
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)


  @@map("classSessions")
}



model ExamSessions{
  id String @id @default(uuid()) @db.Uuid

  classId String @db.Uuid
  class Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)


  title String @db.VarChar(255)
  description String? @db.Text
  day DayOfWeek
  startTime DateTime @db.Time
  endTime DateTime @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String @db.Uuid
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)


  @@map("examSessions")
}



model ExtraCurricularSessions{
  id String @id @default(uuid()) @db.Uuid

  title String @db.VarChar(255)
  description String? @db.Text
  day DayOfWeek
  startTime DateTime @db.Time
  endTime DateTime @db.Time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String @db.Uuid
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)


