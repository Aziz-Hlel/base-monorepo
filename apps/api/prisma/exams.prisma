
enum TimeOfDayEnum {
  MORNING
  EVENING
}

enum SubjectEnum {
  FRENCH
  ENGLISH
  MATH
  PHYSICS
  CHEMISTRY
  BIOLOGY
  HISTORY
  GEOGRAPHY
  ECONOMICS
  COMPUTER_SCIENCE
  SPORT
}

enum MajorEnum {
  MATH
  SCIENCE
  LETTRE
  TECHNIQUE
  ECO
  INFORMATIQUE
  SPORT
}

enum TermEnum {
  PRINCIPAL
  RETAKE
}


model Major {
    id String @id @default(uuid())
    name String @unique @db.VarChar(255)
    

    exams Exam[]
    schools SchoolMajors[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model OptionalExam{
    id String @id @default(uuid())
    name String @unique @db.VarChar(255)

    exams Exam[]
    schools SchoolOptionalExam[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Exam {
    id String @id @default(uuid())
    subject SubjectEnum 

    date DateTime @db.Date
    startTime DateTime @db.Time
    endTime DateTime @db.Time
    timeOfDay TimeOfDayEnum
    term TermEnum 

    isOptional Boolean @default(false)
    majorId String? @db.Uuid
    major Major? @relation(fields: [majorId], references: [id])

    optionalExamId String? @db.Uuid
    optionalExam OptionalExam? @relation(fields: [optionalExamId], references: [id])

    examSessions ExamSession[]
    
    @@index([term])
    
    @@unique([majorId, subject, term])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

}


enum CityEnum {
    YAOUNDE
    DOUALA
    BAMENDA
    MAROUA
    GAROUA
    KUMBO
}


model SchoolMajors{
    id String @id @default(uuid())
    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id])
    majorId String @db.Uuid
    major Major @relation(fields: [majorId], references: [id])

    nbrClasses Int


    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model SchoolOptionalExam{
    id String @id @default(uuid())
    
    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id])
    optionalExamId String @db.Uuid
    optionalExam OptionalExam @relation(fields: [optionalExamId], references: [id])
    
    nbrClasses Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model School {
    id String @id @default(uuid())
    name String @db.VarChar(255)
    publicId String // @unique
    city CityEnum 

    majors SchoolMajors[]
    optionalExams SchoolOptionalExam[]
    classes Class[]
    teachers Teacher[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model Class {
    id String @id @default(uuid())
    name String @db.VarChar(255)

    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id])

    examSessions ExamSession[]

    @@unique([schoolId, name])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}



model Teacher{
  id String @id @default(uuid())
  publicId String @db.VarChar(255)
  lastName String @db.VarChar(255)
  firstName String @db.VarChar(255)
  
  isTeacher Boolean
  subject SubjectEnum

  schoolId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}


model ExamSession {
  id String @id @default(uuid())
  name String @db.VarChar(255)

  classId String @db.Uuid
  class Class @relation(fields: [classId], references: [id])
  
  examId String? @db.Uuid
  exam Exam? @relation(fields: [examId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}