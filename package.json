{
  "name": "mono-repo",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "prepare": "husky || true",
    "preinstall": "npx only-allow pnpm",
    "clean:modules": "pnpm -r exec rimraf node_modules",
    "format:fix": "prettier --write .",
    "prisma:generate": "pnpm -F api exec prisma generate",
    "prisma:migrate:dev": "pnpm -F api exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm -F api exec prisma migrate deploy",
    "prisma:migrate:reset": "pnpm -F api exec prisma migrate reset",
    "docker:local": "node scripts/docker-up.js local",
    "dev:api": "pnpm -F api dev",
    "dev:admin": "pnpm -F admin dev",
    "dev:worker": "pnpm -F worker dev",
    "dev": "pnpm -r --parallel -F api -F admin -F worker dev",
    "docker:dev": "node scripts/docker-up.js dev",
    "docker:build": "node scripts/docker-up.js build",
    "docker:stage": "node scripts/docker-up.js stage",
    "docker:prod": "node scripts/docker-up.js prod ",
    "build:packages": "pnpm -F contracts build && pnpm -F queue build",
    "build:api": "pnpm build:packages && pnpm -F api build",
    "build:admin": "pnpm build:packages && pnpm -F admin build ",
    "start:api": "pnpm -F api start",
    "test": ""
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.18",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "bullmq": "5.71.0",
      "ioredis": "5.9.3"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs"
    ]
  }
}
