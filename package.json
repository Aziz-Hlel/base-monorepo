{
  "name": "mono-repo",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "format:fix": "prettier --write .",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "prisma:migrate:dev": "pnpm --filter api exec prisma migrate dev",
    "docker:local": "node scripts/docker-up.js local",
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev": "pnpm -r --parallel --filter api --filter admin dev",
    "docker:dev": "node scripts/docker-up.js dev",
    "docker:stage": "node scripts/docker-up.js stage",
    "docker:prod": "node scripts/docker-up.js prod ",
    "build": "tsc -b",
    "test": ""
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
