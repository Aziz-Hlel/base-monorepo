{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "tsBuildInfoFile": "./dist/tsconfig.node.tsbuildinfo",

    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,

    "paths": {
      "@repo/contracts/*": ["../../packages/contracts/src/*"]
    }
  },
  "references": [{ "path": "../../packages/contracts" }]
}
