{
  "compilerOptions": {
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "./dist/tsconfig.node.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
