{
  "compilerOptions": {
    // "module": "ESNext",
    // "moduleResolution": "Bundler",
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    // "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "tsBuildInfoFile": "./dist/tsconfig.node.tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
